# Claude provider
# Put the API key supplied by your Claude-compatible provider here.
ANTHROPIC_API_KEY=your_api_key_here

# IMPORTANT: For a third-party Claude router/proxy, set its API base URL.
# Example: https://provider.example.com
# Leave empty only when using the official Anthropic API.
ANTHROPIC_BASE_URL=

# Use the exact model identifier supported by your provider.
CLAUDE_MODEL=claude-opus-5

# Agent
JARVIS_NAME=JARVIS
JARVIS_MAX_TURNS=12
JARVIS_WORKSPACE=.

# Safety
JARVIS_ALLOW_DESTRUCTIVE=false
JARVIS_REQUIRE_APPROVAL=true

# Optional browser automation
JARVIS_BROWSER_HEADLESS=false
