# AI provider
AI_PROVIDER=tabitoken

# TabiToken API key (keep this secret; never commit .env)
TABITOKEN_API_KEY=your_tabitoken_api_key_here

# TabiToken documents an OpenAI-compatible endpoint under /v1.
AI_BASE_URL=https://tabitoken.com/v1

# IMPORTANT: Use the exact model ID shown in your TabiToken account.
AI_MODEL=your-model

# Optional fallback AI provider. If the primary provider returns an access-denied 403,
# JARVIS can switch once to this OpenAI-compatible endpoint and continue the same mission.
# Configure all three fallback connection values together; leave them all blank to disable.
AI_FALLBACK_PROVIDER=
AI_FALLBACK_API_KEY=
AI_FALLBACK_BASE_URL=
AI_FALLBACK_MODEL=

# Agent
JARVIS_NAME=JARVIS
JARVIS_MAX_TURNS=40
JARVIS_WORKSPACE=.

# Safety / permissions
# Access modes: restricted | standard | full
# restricted = observe/read-oriented; standard = use the individual flags below;
# full = enable all capability categories while preserving deny-list/workspace/challenge guards.
JARVIS_ACCESS_MODE=standard
# Full Access still asks before MEDIUM/HIGH actions by default. Set false only for an
# explicitly trusted unattended local session.
JARVIS_FULL_ACCESS_REQUIRE_APPROVAL=true
JARVIS_ALLOW_DESTRUCTIVE=false
JARVIS_REQUIRE_APPROVAL=true
# Arbitrary PowerShell is disabled separately in standard mode because it can escape narrower tool scopes.
JARVIS_ALLOW_SHELL=false
JARVIS_ALLOW_NETWORK=true
JARVIS_ALLOW_GIT_WRITE=true
JARVIS_ALLOW_FILESYSTEM_WRITE=true
JARVIS_ALLOW_BROWSER_WRITE=true
# Comma-separated tool names to deny explicitly. This remains authoritative in every access mode.
JARVIS_DENY_TOOLS=

# Full Access native input backend: auto | python | rust
# The normal Windows launcher now provisions the loopback daemon and forces strict Rust.
# rust = require the Rust daemon and fail closed instead of silently using Python input.
# auto remains available for compatibility when launching components manually.
JARVIS_NATIVE_ENGINE=rust

# JARVIS X Control Center backend: simulation | hybrid | native
# hybrid keeps the normal JARVIS X dashboard and Python planning/semantic layers while
# routing supported low-level native mouse/keyboard mutations through the Rust daemon.
JARVIS_CONTROL_MODE=hybrid
JARVIS_PYTHON_EXECUTABLE=python
# Optional repository root override for the local Python compatibility bridge.
JARVIS_REPO_ROOT=
# The normal npm run dev/start launcher generates session-scoped mTLS material under
# .jarvis/rust-runtime and overrides these values for the current process. These paths
# remain useful when starting the daemon and dashboard manually.
JARVIS_DAEMON_HOST=127.0.0.1
JARVIS_DAEMON_PORT=7443
JARVIS_DAEMON_SERVER_NAME=localhost
JARVIS_DAEMON_CA=daemon/rust/local-pki/ca.pem
JARVIS_DAEMON_CLIENT_CERT=daemon/rust/local-pki/client.pem
JARVIS_DAEMON_CLIENT_KEY=daemon/rust/local-pki/client-key.pem
# Capability IDs must match grants in the daemon config. The integrated launcher discovers
# every Rust display id and supplies the JSON mappings automatically for its session.
JARVIS_DAEMON_OBSERVE_CAPABILITY=
JARVIS_DAEMON_INPUT_CAPABILITY=
JARVIS_DAEMON_OBSERVE_CAPABILITIES_JSON=
JARVIS_DAEMON_INPUT_CAPABILITIES_JSON=

# Optional browser automation
JARVIS_BROWSER_HEADLESS=false

# Real Chrome / CDP
# Existing Chrome must be started with remote debugging to expose the current personal session.
JARVIS_CHROME_CDP_URL=http://127.0.0.1:9222
# Optional explicit chrome.exe path. Leave blank for auto-detection.
JARVIS_CHROME_EXE=
