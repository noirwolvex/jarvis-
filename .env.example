# TabiToken / OpenAI-compatible gateway
ANTHROPIC_API_KEY=your_tabitoken_api_key_here
AI_BASE_URL=https://tabitoken.com/v1
AI_MODEL=your-claude-model-id

# Agent
JARVIS_NAME=JARVIS
JARVIS_MAX_TURNS=12
JARVIS_WORKSPACE=.

# Safety
JARVIS_ALLOW_DESTRUCTIVE=false
JARVIS_REQUIRE_APPROVAL=true

# Optional browser automation
JARVIS_BROWSER_HEADLESS=false
