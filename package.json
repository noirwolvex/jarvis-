{
  "name": "jarvis-x",
  "version": "0.1.0",
  "private": true,
  "description": "Verified autonomous computer operating fabric — reference implementation",
  "workspaces": ["apps/*", "packages/*", "services/*", "database"],
  "engines": { "node": ">=22.12.0" },
  "scripts": {
    "dev": "npm run dev --workspace @jarvis/control-center",
    "build": "npm run build --workspace @jarvis/control-center",
    "start": "npm run start --workspace @jarvis/control-center",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "demo": "npm run demo --workspace @jarvis/runtime",
    "db:validate": "npm run validate --workspace @jarvis/database",
    "db:generate": "npm run generate --workspace @jarvis/database",
    "rust:test": "cargo test --manifest-path daemon/rust/Cargo.toml"
  },
  "devDependencies": {
    "@types/node": "^22.19.0",
    "typescript": "~5.9.3",
    "tsx": "4.23.13"
  }
}
