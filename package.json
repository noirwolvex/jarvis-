{
  "name": "jarvis-x",
  "version": "0.1.0",
  "private": true,
  "description": "Verified autonomous computer operating fabric — reference implementation",
  "workspaces": [
    "apps/*",
    "packages/*",
    "services/*",
    "database"
  ],
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "python scripts/jarvis_runtime.py dev",
    "dev:dashboard": "npm run dev --workspace @jarvis/control-center",
    "build": "npm run build --workspace @jarvis/control-center",
    "start": "python scripts/jarvis_runtime.py start",
    "start:dashboard": "npm run start --workspace @jarvis/control-center",
    "verify:rust-live": "python scripts/jarvis_runtime.py verify-live",
    "verify:browser-live": "python -m scripts.verify_browser_control",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "demo": "npm run simulate --workspace @jarvis/runtime",
    "db:validate": "npm run validate --workspace @jarvis/database",
    "db:generate": "npm run generate --workspace @jarvis/database",
    "rust:test": "cargo test --manifest-path daemon/rust/Cargo.toml"
  },
  "overrides": {
    "@prisma/config": {
      "deepmerge-ts": "8.0.2"
    },
    "prisma": {
      "mysql2": "3.24.4"
    },
    "sharp": "0.35.5",
    "fast-uri": "3.1.8",
    "source-map-js": "1.2.2"
  },
  "devDependencies": {
    "@types/node": "^22.19.0",
    "typescript": "~5.9.3",
    "tsx": "4.23.13"
  }
}
